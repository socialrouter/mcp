{
  "name": "@socialrouter/mcp",
  "version": "0.8.0",
  "description": "MCP server for SocialRouter, let LLM agents extract social media data",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "socialrouter-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && vitest run",
    "test:contract": "vitest run -c vitest.contract.config.ts",
    "preversion": "npm test",
    "prepublishOnly": "npm test && npm run test:contract && npm run build",
    "release": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "socialrouter",
    "social-media",
    "llm",
    "agent",
    "claude",
    "linkedin",
    "instagram"
  ],
  "author": "SocialRouter",
  "license": "MIT",
  "homepage": "https://www.socialrouter.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/socialrouter/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/socialrouter/mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@socialrouter/sdk": "^0.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.9"
  }
}
